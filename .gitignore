# =============================================================================
# Mailinium .gitignore
# =============================================================================

# Build directories
build/
build-*/
out/
_build/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
compile_commands.json

# Qt / MOC generated files
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.autosave

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.user
*.suo
.vs/
*.vcxproj.user

# Compiled binaries
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.pdb
*.exp

# Installer artifacts
*.iss.bak
*.msi
*.dmg
*.pkg
*.deb
*.rpm
*.AppImage

# Log files (never commit logs)
*.log

# Test output
Testing/

# Temporary files
*.tmp
*.bak

# Configuration secrets
config/
